# ===============================================
# TELEGRAM BOT CONFIGURATION
# ===============================================
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Chat or Group ID where booking alerts will be posted (e.g. from @userinfobot)
TELEGRAM_CHAT_ID="your_chat_id_here"

# ===============================================
# QANTY API & DISPENSARY CONFIGURATION
# ===============================================
QANTY_SCHEDULE_URL="https://qanty.com/p/appointments/list_day_schedule"
QANTY_BRANCHES_URL="https://qanty.com/p/get_branches"
# Specific portal URL for medicine dispensation (company code)
QANTY_PORTAL_URL="https://qanty.com/portals/appointments?c=Lpds45xBMVIpsXiSxaTy"
QANTY_COMPANY_CODE="Lpds45xBMVIpsXiSxaTy"

# Target Dispensary / Branch Configuration
# Primary target branch (Medellin branch 6035)
TARGET_BRANCH_ID="6035"
TARGET_BRANCH_NAME="Medellin"
# Multi-branch monitoring: comma-separated list of branches to monitor simultaneously
# E.g. monitor both Medellin branches (118 and 6035):
TARGET_BRANCH_IDS="6035,118"


# Base polling interval in seconds during peak hours
POLL_INTERVAL_SECONDS="45"

# Optional date filter range (YYYY-MM-DD format)
# TARGET_START_DATE="2026-09-15"
# TARGET_END_DATE="2026-10-31"

# ===============================================
# PLAYWRIGHT AUTOMATION CONFIGURATION
# ===============================================
# Run headless (true) or visible window for interactive debugging (false)
PLAYWRIGHT_HEADLESS="true"

# Timeout in milliseconds for browser navigation and selectors
BROWSER_TIMEOUT_MS="30000"

