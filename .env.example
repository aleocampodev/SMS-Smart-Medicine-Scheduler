# ===============================================
# CONFIGURACIÓN DEL BOT DE TELEGRAM
# ===============================================
# Obtén tu token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN="tu_token_aqui"

# ID del chat o grupo donde se enviarán las alertas (ej. de @userinfobot)
TELEGRAM_CHAT_ID="tu_chat_id_aqui"

# ===============================================
# CONFIGURACIÓN DE LA API DE QANTY
# ===============================================
QANTY_SCHEDULE_URL="https://qanty.com/p/appointments/list_day_schedule"
# URL específica del portal de dispensación de medicamentos (compañía)
QANTY_PORTAL_URL="https://qanty.com/portals/appointments?c=Lpds45xBMVIpsXiSxaTy"
QANTY_COMPANY_CODE="Lpds45xBMVIpsXiSxaTy"
# Intervalo de sondeo en segundos (recomendado: 30 a 60 segundos)
POLL_INTERVAL_SECONDS="45"

# Rango opcional de fechas a monitorear (formato YYYY-MM-DD, opcional)
# TARGET_START_DATE="2026-09-15"
# TARGET_END_DATE="2026-10-31"

# ===============================================
# CONFIGURACIÓN DE PLAYWRIGHT / MCP SCRAPING
# ===============================================
# Ejecutar en modo oculto (true) o con ventana visible para depurar (false)
PLAYWRIGHT_HEADLESS="true"

# Timeout en milisegundos para operaciones del navegador
BROWSER_TIMEOUT_MS="30000"
