{
  "name": "SMS",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.18.0",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.10",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.19.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "dev:scheduler": "turbo run dev -F @SMS/scheduler --",
    "start": "turbo run start -F @SMS/scheduler --",
    "start:scheduler": "turbo run start -F @SMS/scheduler --",
    "test:scheduler": "turbo run test -F @SMS/scheduler --",
    "test": "turbo run test -F @SMS/scheduler --",
    "test:rules": "turbo run test:rules -F @SMS/scheduler --",
    "test:guardrails": "turbo run test:guardrails -F @SMS/scheduler --",
    "test:adaptive": "turbo run test:adaptive -F @SMS/scheduler --",
    "test:branches": "turbo run test:branches -F @SMS/scheduler --",
    "test:session": "turbo run test:session -F @SMS/scheduler --",
    "test:poller": "turbo run test:poller -F @SMS/scheduler --",
    "inspect:api": "turbo run inspect:api -F @SMS/scheduler --",
    "list:branches": "turbo run list:branches -F @SMS/scheduler --",
    "harvest:manual": "turbo run harvest:manual -F @SMS/scheduler --",
    "watch:horizon": "turbo run watch:horizon -F @SMS/scheduler --",
    "db:push": "turbo run db:push -F @SMS/db --",
    "db:studio": "turbo run db:studio -F @SMS/db --",
    "db:generate": "turbo run db:generate -F @SMS/db --",
    "db:migrate": "turbo run db:migrate -F @SMS/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@SMS/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.4.3"
}
