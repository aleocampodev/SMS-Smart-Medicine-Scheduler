{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@SMS/api": "workspace:*",
    "@SMS/auth": "workspace:*",
    "@SMS/db": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@SMS/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
